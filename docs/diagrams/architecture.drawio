        <mxCell id="api" value="FastAPI&#10;app.py, Swagger at /docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8F2;strokeColor=#3F5040;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="75" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="retr" value="Retriever&#10;numpy cosine, in memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8F2;strokeColor=#3F5040;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="620" y="165" width="200" height="55" as="geometry" />
