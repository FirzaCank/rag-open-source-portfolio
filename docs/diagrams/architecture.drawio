        <mxCell id="note" value="The browser never calls rag-api directly.&#10;NEXT_PUBLIC_* is inlined into the bundle at build time, so a browser side call would publish the GPU service URL and the API key." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4E3DA;strokeColor=#8E3F1F;align=left;fontSize=10;verticalAlign=top;spacing=6" vertex="1" parent="1">
