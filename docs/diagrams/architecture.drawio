        </mxCell>
        <mxCell id="svc_api" value="rag-api&#10;Cloud Run, 1x NVIDIA L4, scales to zero" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#A8B89E;strokeColor=#3F5040;dashed=1;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="30" width="470" height="360" as="geometry" />
