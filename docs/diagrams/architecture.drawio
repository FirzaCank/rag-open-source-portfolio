          <mxGeometry x="860" y="255" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Output filter and send guard&#10;deterministic, in code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4E3DA;strokeColor=#B5552E;fontSize=11;fontStyle=1" vertex="1" parent="1">
