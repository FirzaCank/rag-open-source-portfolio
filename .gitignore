# Secrets. Never committed, see CLAUDE.md Security.
.env
.env.*
*.pem
*-key.json
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local model weights and exports. Delivered by the image build, not by git.
*.gguf
*.onnx
*.safetensors
models/

# Experiment output. MLflow runs live on GCS, see D9.
mlruns/
mlflow.db

# DVC cache. Data remote is GCS, see D8.
/data/.dvc/cache
.dvc/cache
.dvc/tmp

# Logs only. `eval_runs/` is committed on purpose: those JSON files are the evidence behind every
# model comparison in the report, and a comparison with no stored run is an unverifiable claim.
*.log

# Node, only used by scripts/export-portfolio.ts
node_modules/

# Working documents. Kept local on purpose, not published to the public repo.
# Phase 6 produces the public-facing documentation separately.
/CLAUDE.md
/CONTEXT.md
/docs/CHECKPOINT.md
/docs/DECISIONS.md
/docs/GAMMA_PASTE.md
/docs/LINKEDIN.md

# macOS
.DS_Store
