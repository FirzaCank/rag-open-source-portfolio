        "on its way",
        "contact"
      ]
    },
    {
      "id": "send-rejects-invalid-email",
      "category": "send-message",
      "messages": [
        {
          "role": "user",
          "content": "I want to reach Firza about a project. My name is Budi, email budi@@invalid, message: interested in a dashboard project."
        },
        {
          "role": "assistant",
          "content": "Thank you, Budi. Shall I send this to Firza?\n\n\"Interested in a dashboard project.\""
        },
        {
          "role": "user",
          "content": "yes"
