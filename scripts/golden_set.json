    {
      "id": "multi-followup",
      "category": "multi-turn",
      "messages": [
        {
          "role": "user",
          "content": "What did Firza do at Hypefast?"
        },
        {
          "role": "assistant",
          "content": "Firza works at **Hypefast** as a Data Engineer, building ETL pipelines, recommendation systems, and AI-driven automation across 11+ brands."
        },
        {
          "role": "user",
          "content": "tell me more about that"
