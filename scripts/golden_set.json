    {
      "id": "send-refuses-second-send",
      "category": "send-message",
      "messages": [
        {
          "role": "user",
          "content": "I'm a recruiter at Gojek, I'd like to reach Firza about a Senior Data Engineer role."
        },
        {
          "role": "assistant",
          "content": "Happy to pass that along. Could you share your name, your email address, and what you'd like to tell Firza?"
        },
        {
          "role": "user",
          "content": "Rina Wijaya, rina.wijaya@gojek.com. We'd like to schedule an intro call this week."
